# Example configuration. Non-secret values live in wrangler.jsonc "vars".
# Secrets: set with `npx wrangler secret put <NAME>` (production) or in .dev.vars (local, git-ignored).
# Never commit real values.

# --- secrets ---
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=replace-with-32-to-256-random-chars-A-Za-z0-9_-
INVITE_HMAC_SECRET=replace-with-at-least-32-random-chars

# --- vars (see wrangler.jsonc) ---
TELEGRAM_BOT_USERNAME=YourEscrowBot
BITCOIN_NETWORK=signet
ALLOW_MAINNET=false
# MAINNET_RELEASE_CONFIRMATION is only set after docs/MAINNET-CHECKLIST.md is complete
SUPPORT_BOT_URL=https://t.me/GruppennetzwerkKontakt_bot
CRYPTGEON_URL=https://cryptgeon.org
DEFAULT_COMMISSION_BPS=300
REFUND_COMMISSION_BPS=0
COMMISSION_ADDRESS=tb1q-your-own-externally-managed-signet-address
MIN_CONFIRMATIONS_SIGNET=1
MIN_CONFIRMATIONS_MAINNET=3
BLOCKCHAIN_PROVIDER=esplora
ESPLORA_PRIMARY_URL=https://mempool.space/signet/api
ESPLORA_SECONDARY_URL=https://blockstream.info/signet/api
MAX_FEE_RATE_SAT_VB=50
MAX_FEE_PERCENT=5
POLL_MAX_TRADES_PER_RUN=4
ENABLE_AUTOMATIC_BROADCAST=false
ENABLE_CUSTODIAL_FEATURES=false
ADMIN_TELEGRAM_IDS=
DATA_RETENTION_DAYS=180
