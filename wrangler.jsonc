{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-telegram-escrow",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },

  // Static assets: picture guides (public/guide/*.png). All other paths go to the Worker.
  "assets": { "directory": "./public" },

  // One Worker serves the Telegram webhook (fetch) and the blockchain poller (scheduled).
  "triggers": { "crons": ["*/5 * * * *"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "escrow",
      // PLACEHOLDER: output of `npx wrangler d1 create escrow` (see docs/DEPLOYMENT.md)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],

  // Non-secret configuration. Secrets (TELEGRAM_BOT_TOKEN, TELEGRAM_WEBHOOK_SECRET,
  // INVITE_HMAC_SECRET) are set with `wrangler secret put` and never committed.
  // Values marked PLACEHOLDER must be replaced before deploying (docs/DEPLOYMENT.md).
  // `npm run validate-config` checks the result.
  "vars": {
    // PLACEHOLDER: your bot's username from BotFather (without @)
    "TELEGRAM_BOT_USERNAME": "YourEscrow_bot",
    // Default: signet test network. Mainnet stays locked until you set ALLOW_MAINNET "true"
    // and MAINNET_RELEASE_CONFIRMATION (see docs/MAINNET-CHECKLIST.md). Your own responsibility.
    "BITCOIN_NETWORK": "signet",
    "ALLOW_MAINNET": "false",
    "SUPPORT_BOT_URL": "https://t.me/GruppennetzwerkKontakt_bot",
    "CRYPTGEON_URL": "https://cryptgeon.org",
    "DEFAULT_COMMISSION_BPS": "300",
    "REFUND_COMMISSION_BPS": "0",
    // PLACEHOLDER: your own fee address for the configured network (tb1... on signet,
    // bc1... on mainnet), managed in your own wallet. The bot never holds its keys.
    "COMMISSION_ADDRESS": "REPLACE_WITH_YOUR_FEE_ADDRESS",
    "MIN_CONFIRMATIONS_SIGNET": "1",
    "MIN_CONFIRMATIONS_MAINNET": "3",
    "BLOCKCHAIN_PROVIDER": "esplora",
    "ESPLORA_PRIMARY_URL": "https://mempool.space/signet/api",
    "ESPLORA_SECONDARY_URL": "https://blockstream.info/signet/api",
    "MAX_FEE_RATE_SAT_VB": "50",
    "MAX_FEE_PERCENT": "5",
    "POLL_MAX_TRADES_PER_RUN": "4",
    "ENABLE_AUTOMATIC_BROADCAST": "false",
    "ENABLE_CUSTODIAL_FEATURES": "false",
    // Optional: comma-separated numeric Telegram user ids with /admin access
    "ADMIN_TELEGRAM_IDS": "",
    // Optional: https://btc-telegram-escrow.<account>.workers.dev (serves the picture guides)
    "PUBLIC_BASE_URL": "",
    // Optional operator mode: the operator is the automatic arbiter. Set both or neither.
    // OPERATOR_ARBITER_KEY = public key with key origin only, e.g. "[fingerprint/48h/1h/0h/2h]tpub..."
    // (see docs/OPERATOR-SETUP.md). Never a private key or seed.
    "OPERATOR_TELEGRAM_ID": "",
    "OPERATOR_ARBITER_KEY": "",
    "DATA_RETENTION_DAYS": "180",
  },
}
