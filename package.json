{
  "name": "btc-telegram-escrow",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial 2-of-3 multisig Bitcoin escrow coordinator for Telegram (Cloudflare Workers + D1). Signet only.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply escrow --local",
    "db:migrate:remote": "wrangler d1 migrations apply escrow --remote",
    "validate-config": "node --experimental-strip-types scripts/validate-config.ts",
    "set-webhook": "node --experimental-strip-types scripts/set-telegram-webhook.ts",
    "verify-signet": "node --experimental-strip-types scripts/verify-signet.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "e2e": "node --experimental-strip-types scripts/signet-e2e.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@scure/bip32": "2.4.0",
    "@scure/btc-signer": "2.4.1",
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "bitcoinjs-lib": "7.0.4",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tiny-secp256k1": "2.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
